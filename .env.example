# Server
PORT=3000
HOST=http://localhost:3000

# YouTube Data API (for finding trending streams)
YOUTUBE_API_KEY=your_youtube_api_key_here

# LLM for caption generation (OpenAI-compatible router)
BYNARA_API_KEY=your_by_nara_api_key_here
BYNARA_BASE_URL=https://router.bynara.id/v1
BYNARA_MODEL=agnes-2.5-flash

# Alternative: direct OpenAI key (if you add one later)
OPENAI_API_KEY=

# Twitch API
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_ACCESS_TOKEN=your_twitch_access_token_here

# Instagram (headless browser - no API key needed)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# Optional: Cloud storage for temporary clips
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
